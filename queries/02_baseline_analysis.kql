// All available days; eight days is a limited baseline, not proof of travel history.
CloudoraSignIn_CL
| where UserPrincipalName in~ ("daniel.reeve@cloudora.io", "omar.farah@cloudora.io")
| summarize SignIns=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Failures=countif(tostring(ResultType) != "0") by UserPrincipalName, Country, City, IPAddress
| order by UserPrincipalName asc, SignIns desc
