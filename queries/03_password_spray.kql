// Run separately: first discover sources, then inspect per-user intensity.
CloudoraSignIn_CL
| where tostring(ResultType) == "50126"
| summarize Failures=count(), TargetedAccounts=dcount(UserPrincipalName) by IPAddress, Country
| order by Failures desc

let SuspectIPs = dynamic(["102.89.44.17", "102.89.44.23", "102.89.45.101"]);
CloudoraSignIn_CL
| where IPAddress in (SuspectIPs)
| summarize Attempts=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by UserPrincipalName, IPAddress, ResultCode=tostring(ResultType), Day=bin(TimeGenerated, 1d)
| order by Day asc, UserPrincipalName asc
