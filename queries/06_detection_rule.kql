// Historical replay: change EvaluationTime to each test point on the first spray night.
// Production: replace the fixed datetime with now(); table/schema must be adapted.
let EvaluationTime = datetime(2026-08-11T00:00:00Z);
let Lookback = 6h;
let MinimumFailures = 20;
let MinimumAccounts = 10;
CloudoraSignIn_CL
| where TimeGenerated > EvaluationTime - Lookback and TimeGenerated <= EvaluationTime
| where tostring(ResultType) == "50126"
| summarize Failures=count(), TargetedAccounts=dcount(UserPrincipalName), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Accounts=make_set(UserPrincipalName, 100) by IPAddress
| where Failures >= MinimumFailures and TargetedAccounts >= MinimumAccounts
| extend TimeGenerated=LastSeen
| project TimeGenerated, IPAddress, Failures, TargetedAccounts, FirstSeen, LastSeen, Accounts
